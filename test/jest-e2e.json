{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "setupFilesAfterEnv": ["./setup-db.e2e.ts"],
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@app/modules/(.*)$": "<rootDir>/../src/modules/$1",
    "^@app/auth/(.*)$": "<rootDir>/../src/modules/auth/$1",
    "^@app/common/(.*)$": "<rootDir>/../src/common/$1",
    "^src/(.)$": "<rootDir>/src/$1",
    "^@app/(.*)$": "<rootDir>/../src/$1"
  }
}
